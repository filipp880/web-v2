{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "StorageMode": "InMemory",
  "JwtSettings": {
    "SecretKey": "TramWebAppSecretKeyForDevelopmentOnlyChangeInProduction12345678901234567890",
