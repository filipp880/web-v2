{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "StorageMode": "PostgreSQL",
  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Port=5432;Database=tramwebapp;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "SecretKey": "TramWebAppSecretKeyForDevelopmentOnlyChangeInProduction12345678901234567890",
    "Issuer": "TramWebApp",
    "Audience": "TramWebAppUsers",
    "ExpiryMinutes": "60"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://localhost:3000", "http://frontend:80"]
  }
}